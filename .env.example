GEMINI_API_KEY=

# Persona yaml utvonala. Alapertelmezes: persona/izzie.yaml (a repo gyokerehez kepest)
IZZIE_PERSONA=

# SQLite adatbazis utvonala. Alapertelmezes: data/izzie.db (a repo gyokerehez kepest)
IZZIE_DB_PATH=

# Extractor-prompt utvonala. Alapertelmezes: prompts/extractor.md (a repo gyokerehez kepest)
IZZIE_EXTRACTOR_PROMPT=

# Bearer token minden vedett vegponthoz (Authorization: Bearer <token>).
# Eloallitasa: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Hianya vagy ures erteke eseten az alkalmazas nem indul el.
IZZIE_API_TOKEN=

# CORS: engedelyezett eredetek, vesszovel elvalasztva.
# Alapertelmezes: http://localhost:1420,http://tauri.localhost
IZZIE_CORS_ORIGINS=
